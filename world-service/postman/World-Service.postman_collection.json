{
	"info": {
		"_postman_id": "a8165e9b-3648-4f2e-9c3d-1e2f3a4b5c6d",
		"name": "World Service (gRPC)",
		"description": "Внутренний world-service. Импортируйте также proto: world-service/proto/world/v1/world.proto в Service definition каждого запроса, если Postman не подхватит схему из коллекции.\n\nПеред прогоном: задайте переменные коллекции `grpcHost`, `worldId`, при необходимости `serviceToken`. Для повторного Create смените `worldId` или сначала выполните DeleteWorld.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "grpcHost",
			"value": "localhost:50054"
		},
		{
			"key": "worldId",
			"value": "test-world-postman"
		},
		{
			"key": "serviceToken",
			"value": ""
		},
		{
			"key": "worldVersion",
			"value": "1"
		}
	],
	"item": [
		{
			"name": "CreateWorld",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Ответ получен', function () {",
							"    pm.expect(pm.response).to.exist;",
							"});",
							"try {",
							"    const body = pm.response.json();",
							"    if (body && body.world) {",
							"        pm.collectionVariables.set('worldVersion', String(body.world.version));",
							"        pm.test('id совпадает', function () {",
							"            pm.expect(body.world.id).to.eql(pm.collectionVariables.get('worldId'));",
							"        });",
							"    }",
							"} catch (e) {",
							"    console.warn('parse response', e);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "grpc://{{grpcHost}}",
					"protocol": "grpc",
					"host": ["{{grpcHost}}"]
				},
				"grpc": {
					"service": "world.v1.WorldService",
					"method": "CreateWorld",
					"message": {
						"id": "{{worldId}}",
						"name": "Postman test",
						"description": "from collection",
						"snapshot": "",
						"schemaVersion": 1
					},
					"metadata": [
						{
							"key": "x-service-token",
							"value": "{{serviceToken}}",
							"enabled": true
						}
					]
				}
			}
		},
		{
			"name": "GetWorld",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Ответ получен', function () {",
							"    pm.expect(pm.response).to.exist;",
							"});",
							"try {",
							"    const body = pm.response.json();",
							"    if (body && body.world) {",
							"        pm.collectionVariables.set('worldVersion', String(body.world.version));",
							"        pm.test('версия > 0', function () {",
							"            pm.expect(body.world.version).to.be.above(0);",
							"        });",
							"    }",
							"} catch (e) {}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "grpc://{{grpcHost}}",
					"protocol": "grpc",
					"host": ["{{grpcHost}}"]
				},
				"grpc": {
					"service": "world.v1.WorldService",
					"method": "GetWorld",
					"message": {
						"id": "{{worldId}}"
					},
					"metadata": [
						{
							"key": "x-service-token",
							"value": "{{serviceToken}}",
							"enabled": true
						}
					]
				}
			}
		},
		{
			"name": "ReplaceWorldSnapshot",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Ответ получен', function () {",
							"    pm.expect(pm.response).to.exist;",
							"});",
							"try {",
							"    const body = pm.response.json();",
							"    if (body && body.world) {",
							"        pm.collectionVariables.set('worldVersion', String(body.world.version));",
							"        pm.test('версия увеличилась после replace', function () {",
							"            pm.expect(body.world.version).to.be.at.least(2);",
							"        });",
							"    }",
							"} catch (e) {}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "grpc://{{grpcHost}}",
					"protocol": "grpc",
					"host": ["{{grpcHost}}"]
				},
				"grpc": {
					"service": "world.v1.WorldService",
					"method": "ReplaceWorldSnapshot",
					"message": {
						"id": "{{worldId}}",
						"snapshot": "e30=",
						"schemaVersion": 1,
						"expectedVersion": 0
					},
					"metadata": [
						{
							"key": "x-service-token",
							"value": "{{serviceToken}}",
							"enabled": true
						}
					]
				}
			}
		},
		{
			"name": "ListWorlds",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Ответ получен', function () {",
							"    pm.expect(pm.response).to.exist;",
							"});",
							"try {",
							"    const body = pm.response.json();",
							"    pm.test('есть массив worlds', function () {",
							"        pm.expect(body.worlds).to.be.an('array');",
							"    });",
							"} catch (e) {}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "grpc://{{grpcHost}}",
					"protocol": "grpc",
					"host": ["{{grpcHost}}"]
				},
				"grpc": {
					"service": "world.v1.WorldService",
					"method": "ListWorlds",
					"message": {
						"limit": 20,
						"offset": 0
					},
					"metadata": [
						{
							"key": "x-service-token",
							"value": "{{serviceToken}}",
							"enabled": true
						}
					]
				}
			}
		},
		{
			"name": "DeleteWorld",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Ответ получен', function () {",
							"    pm.expect(pm.response).to.exist;",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"url": {
					"raw": "grpc://{{grpcHost}}",
					"protocol": "grpc",
					"host": ["{{grpcHost}}"]
				},
				"grpc": {
					"service": "world.v1.WorldService",
					"method": "DeleteWorld",
					"message": {
						"id": "{{worldId}}"
					},
					"metadata": [
						{
							"key": "x-service-token",
							"value": "{{serviceToken}}",
							"enabled": true
						}
					]
				}
			}
		}
	]
}
